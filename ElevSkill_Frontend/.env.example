# ELEVSKILL AI — Frontend Environment Configuration
# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project Settings -> Environment Variables.

# Direct Python FastAPI AI Service URLs
# Local dev defaults: http://127.0.0.1:8000 / 8002 / 8003 / 8004
# Production (Vercel): set each to your deployed Render HTTPS URL (e.g., https://elevskill-resume-analyzer.onrender.com)
VITE_RESUME_ANALYZER_API_URL=http://127.0.0.1:8000
VITE_INTERVIEW_COACH_API_URL=http://127.0.0.1:8002
VITE_JOB_MATCHER_API_URL=http://127.0.0.1:8003
VITE_CAREER_ROADMAP_API_URL=http://127.0.0.1:8004

# Firebase Web App Configuration (ELEVSKILL-Web / elevskill-ai-hybrid)
# Put real values in .env.local or Vercel Environment Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=elevskill-ai-hybrid
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3 site key required in production; debug token is local-dev only)
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
VITE_FIREBASE_AI_CLOUD_MODEL=gemini-3.5-flash-lite
